# A.C.E.S. county server settings. None of these are secret: the secrets are kept
# encrypted by install-aces-service.ps1, never in this file.
# One KEY=value per line. After a change, restart the "A.C.E.S. Server" task
# (docs/OPERATIONS.md, "Start, stop and restart").

# Where the server listens. 443 if nothing else on the server uses it (IIS would).
HOST=0.0.0.0
PORT=443
# This server's address as staff type it, for download links in specialist answers.
ACES_PUBLIC_BASE_URL=https://aces.example.bernco.gov

# HTTPS, from the county certificate exported as PEM files (docs/OPERATIONS.md).
ACES_TLS_CERT_FILE=C:\ProgramData\ACES\tls\aces-cert.pem
ACES_TLS_KEY_FILE=C:\ProgramData\ACES\tls\aces-key.pem

# County sign-in run by the server (aces_oidc.py). The client secret is with the secrets.
ACES_OIDC_TENANT_ID=
ACES_OIDC_CLIENT_ID=
ACES_OIDC_REDIRECT_URI=https://aces.example.bernco.gov/auth/callback
# Who gets in: the staff security group's object ID, plus any named exceptions.
ACES_ALLOWED_GROUPS=
ACES_ALLOWED_USERS=

# ACES database. The server signs in as its own Windows service account
# (sql/56_SERVICE_ACCOUNT_LOGIN.sql), so there's no database password anywhere.
ACES_SQL_TOOLS_ENABLED=true
ACES_SQL_SERVER=asbcdbbernt
ACES_SQL_DATABASE=ASRCustomerService
ACES_SQL_AUTH=Windows
# The county SQL server uses a self-signed certificate. The connection is still encrypted.
ACES_SQL_TRUST_SERVER_CERT=true

# CustomGPT specialist projects (the API token is with the secrets).
COMMUNITY_PROJECT_ID=9262
ASSESSMENT_PROJECT_ID=94006
CLEAR_PROJECT_ID=49501
COMPLIANCE_PROJECT_ID=37400
SMART_TASKS_PROJECT_ID=9262
HOMEHARVEST_ACTION_ID=7

# Chat model for /ui. Not decided for the county server yet. With nothing set here and no
# model key in the secrets, the chat page says chat is off and the MCP tools still work.
# ACES_CHAT_PROVIDER=azure_openai
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_DEPLOYMENT=

# Field route planner. Set this once it's hosted somewhere the county owns.
# UPC_ROUTER_URL=

# Logs (in the data folder's logs\ subfolder). Set to the county's retention for these logs.
ACES_LOG_KEEP_DAYS=90

# A.C.E.S. MCP server settings for a Linux host (Docker). install.sh copies this file to
# /etc/aces/aces.env, owned by root and readable by root only, because it holds secrets.
#
# One KEY=value per line. No spaces around =. If a value contains $, # or a quote, wrap
# it in single quotes: ACES_SQL_PASSWORD='pa$$word'.
# After a change: sudo linux/update.sh --restart
#
# The container's own paths (cache, logs, signing key, port) are set in docker-compose.yml,
# not here.

# This server's address as staff type it, for download links in specialist answers.
ACES_PUBLIC_BASE_URL=https://aces.example.bernco.gov

# HTTPS. The files go in /etc/aces/tls on the host; the container sees that folder as /tls.
# Leave both blank only if a proxy in front of the server handles HTTPS (see README).
ACES_TLS_CERT_FILE=/tls/aces-cert.pem
ACES_TLS_KEY_FILE=/tls/aces-key.pem
# Only if the key file has a password.
ACES_TLS_KEY_PASSWORD=

# County sign-in run by the server (aces_oidc.py).
ACES_OIDC_TENANT_ID=
ACES_OIDC_CLIENT_ID=
ACES_OIDC_CLIENT_SECRET=
ACES_OIDC_REDIRECT_URI=https://aces.example.bernco.gov/auth/callback
# Who gets in: the staff security group's object ID, plus any named exceptions.
ACES_ALLOWED_GROUPS=
ACES_ALLOWED_USERS=

# Access keys. install.sh fills these with new random values the first time it runs.
# Copilot Studio and CustomGPT use the MCP key; Power Automate and the admin routes use the token.
ACES_MCP_API_KEY=
ACES_ADMIN_TOKEN=

# ACES database. Use the server's full DNS name if the short name doesn't resolve inside
# the container. The county SQL server uses a self-signed certificate; the connection is
# still encrypted.
ACES_SQL_TOOLS_ENABLED=true
ACES_SQL_SERVER=<sql server name>
ACES_SQL_DATABASE=<database name>
ACES_SQL_AUTH=SqlPassword
ACES_SQL_USER=<sql login>
ACES_SQL_PASSWORD=
ACES_SQL_TRUST_SERVER_CERT=true

# CustomGPT specialist projects.
CUSTOMGPT_API_TOKEN=
COMMUNITY_PROJECT_ID=9262
ASSESSMENT_PROJECT_ID=94006
CLEAR_PROJECT_ID=49501
COMPLIANCE_PROJECT_ID=37400
SMART_TASKS_PROJECT_ID=9262
HOMEHARVEST_ACTION_ID=7

# Chat model for /ui. With none set, the chat page says chat is off and the MCP tools
# still work. Set one only once it's approved.
# ACES_CHAT_PROVIDER=azure_openai
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Field route planner. Set this once it's hosted somewhere the county owns.
# UPC_ROUTER_URL=

# Log files rotate at midnight. Set this to the county's retention for these logs.
ACES_LOG_KEEP_DAYS=90
